# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is ignored by git, so your real secrets never get committed.
# These variables are read only on the server (in src/app/actions.ts), so they
# are never sent to the visitor's browser. Do NOT prefix them with NEXT_PUBLIC_.

# API key from https://resend.com (API keys section). Treat it like a password.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The inbox that receives contact form messages.
# While the sender is onboarding@resend.dev, this must be the email address of
# your own Resend account (Resend refuses other recipients until you verify a domain).
CONTACT_EMAIL=you@example.com
