# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is ignored by git, so your real secrets never get committed.
# These variables are read only on the server (in src/app/actions.ts), so they
# are never sent to the visitor's browser. Do NOT prefix them with NEXT_PUBLIC_.

# API key from https://resend.com (API keys section). Treat it like a password.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The inbox that receives contact form messages.
# While the sender is onboarding@resend.dev, this must be the email address of
# your own Resend account (Resend refuses other recipients until you verify a domain).
CONTACT_EMAIL=you@example.com

# The public URL of the deployed site, without a trailing slash.
# Used as `metadataBase` (so Open Graph / Twitter image URLs are absolute) and
# by sitemap.xml and robots.txt. This one IS meant to be public, hence the
# NEXT_PUBLIC_ prefix. It is read at build time, so set it in your host's
# build environment. Falls back to Vercel's production domain, then localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
